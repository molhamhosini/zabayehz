# Backend that the mobile app already uses
API_BASE_URL=https://poszabayeh.com
# Public URL of this website (used for SEO links and the sitemap)
SITE_URL=https://zabayeah.com
# Set to 1 to use the sample data in /fixtures instead of the live API (offline development)
MOCK_API=0
# Categories shown on the website (others, e.g. POS-only items, are hidden from lists, search and product pages)
SHOP_CATEGORY_IDS=13,15,16,17
